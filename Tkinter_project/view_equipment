# FUNCTION TO CHECKOUT ITEM (THREADED)
# ---------------------------
def submit_checkout_threaded(employee_id):
    """Run the checkout process in a separate thread"""
    if not employee_id:
        return
    
    # Disable button to prevent multiple clicks
    checkout_button.config(state='disabled', text='Processing...')
    
    def checkout_worker():
        try:
            submit_checkout(employee_id)
        finally:
            # Re-enable button regardless of success or failure
            root.after(0, lambda: checkout_button.config(state='normal', text='Checkout and Show Activity'))
    
    # Start the worker thread
    thread = threading.Thread(target=checkout_worker, daemon=True)
    thread.start()

def submit_checkout(employee_id):
    try:
        timeout = 30
        
        # POST request to check out the next available item
        payload = {"employee_id": employee_id}
        print(f"Sending POST request to {API_URL_POST}")
        print(f"Payload: {payload}")
        
        response_post = requests.post(
            API_URL_POST,
            json=payload,
            auth=(USERNAME, PASSWORD),
            timeout=timeout,
            verify=False,
            headers={
                'Content-Type': 'application/json',
                'User-Agent': 'Equipment-Checkout-App/1.0'
            }
        )
        
        print(f"Connection successful!")
        print(f"POST Response: {response_post.text}")
        
        response_post.raise_for_status()
        
        try:
            result_post = response_post.json()
        except ValueError:
            return
        
        if result_post.get("status") == "success":
            booking_id = result_post.get("booking_id")
            item_id = result_post.get("item_id")
            print(f"Success: Item checked out (Booking ID: {booking_id}, Item ID: {item_id})")
        else:
            print(f"Error: {result_post.get('message', 'Unknown error during checkout')}")
            return
        
        # GET request to fetch this employee's activity
        print(f"Sending GET request to {API_URL_GET}")
        
        response_get = requests.get(
            API_URL_GET,
            params={"employee_id": employee_id},
            auth=(USERNAME, PASSWORD),
            timeout=timeout,
            verify=False,
            headers={'User-Agent': 'Equipment-Checkout-App/1.0'}
        )
        
        print(f"Connection successful!")
        
        response_get.raise_for_status()
        
        try:
            data = response_get.json()
        except ValueError:
            return
        
        # Extract items from the response
        if isinstance(data, dict) and "items" in data:
            items = data["items"]
        elif isinstance(data, list):
            items = data
        else:
            items = []
        
        # Filter items for this specific employee
        employee_items = [item for item in items if str(item.get("employee_id")) == str(employee_id)]
        
        if not employee_items:
            print(f"No activity found for Employee ID: {employee_id}")
            return
        
        # Create and show results window
        root.after(0, lambda: create_results_window(employee_id, employee_items))
        
    except requests.exceptions.Timeout:
        print("Error: Request timed out. Check your connection.")
    except requests.exceptions.ConnectionError as e:
        print(f"Error: Cannot connect to server: {str(e)}")
    except requests.exceptions.HTTPError as e:
        print(f"Error: Server error: {e}")
    except Exception as e:
        print(f"Error: Unexpected error: {str(e)}")

