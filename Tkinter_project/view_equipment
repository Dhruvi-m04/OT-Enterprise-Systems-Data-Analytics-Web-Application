# ---------------------------
# FUNCTION TO CREATE RESULTS WINDOW
# ---------------------------
def create_results_window(employee_id, items):
    """Create a new window to display the results table"""
    results_window = tk.Toplevel(root)
    results_window.title(f"Usage Report - Employee ID: {employee_id}")
    results_window.geometry("1200x600")
    results_window.configure(bg='#f0f0f0')
    
    # Create main frame
    main_frame = tk.Frame(results_window, bg='#f0f0f0')
    main_frame.pack(fill='both', expand=True, padx=10, pady=10)
    
    # Create a frame for the table
    table_frame = tk.Frame(main_frame, relief='solid', bd=1)
    table_frame.pack(fill='both', expand=True)
    
    # Create Treeview with custom style
    style = ttk.Style()
    style.theme_use('clam')
    
    # Configure the treeview style
    style.configure("Results.Treeview.Heading",
                    background='#e1e1e1',
                    foreground='black',
                    font=('Arial', 10, 'bold'),
                    borderwidth=1,
                    relief='solid')
    
    style.configure("Results.Treeview",
                    background='white',
                    foreground='black',
                    fieldbackground='white',
                    font=('Arial', 9),
                    borderwidth=0)
    
    # Create the table
    tree = ttk.Treeview(
        table_frame,
        columns=("Booking ID", "Item ID", "Employee ID", "Date Booked", "Date Returned"),
        show='headings',
        style="Results.Treeview"
    )
    
    # Configure column headings and widths
    columns_config = [
        ("Booking ID", 120),
        ("Item ID", 150),
        ("Employee ID", 150),
        ("Date Booked", 200),
        ("Date Returned", 200)
    ]
    
    for col, width in columns_config:
        tree.heading(col, text=col)
        tree.column(col, width=width, minwidth=100, anchor='center')
    
    # Configure row tags for alternating colors
    tree.tag_configure("even_row", background='#f8f8f8')
    tree.tag_configure("odd_row", background='white')
    tree.tag_configure("even_row_not_returned", background='#e3f2fd')
    tree.tag_configure("odd_row_not_returned", background='#bbdefb')
    
    # Sort items by booking_id (newest first)
    sorted_items = sorted(items, key=lambda x: x.get("booking_id", 0), reverse=True)
    
    # Insert data into table
    for i, item in enumerate(sorted_items):
        booking_id = item.get("booking_id", "")
        item_id = item.get("item_id", "")
        employee_id_data = item.get("employee_id", "")
        date_booked = item.get("date_booked", "")
        date_returned = item.get("date_returned")
        
        # Alternate row colors
        if i % 2 == 0:
            tags = ("even_row",)
        else:
            tags = ("odd_row",)
        
        # Add special highlighting for non-returned items
        if date_returned == "None":
            if i % 2 == 0:
                tags = ("even_row_not_returned",)
            else:
                tags = ("odd_row_not_returned",)
        
        tree.insert("", tk.END, values=(
            booking_id,
            item_id,
            employee_id_data,
            date_booked,
            date_returned
        ), tags=tags)
    
    # Pack the tree
    tree.pack(side='left', fill='both', expand=True)
    
    # Add scrollbar
    scrollbar = ttk.Scrollbar(table_frame, orient="vertical", command=tree.yview)
    scrollbar.pack(side='right', fill='y')
    tree.configure(yscrollcommand=scrollbar.set)
    
    # Add a close button
    close_frame = tk.Frame(main_frame, bg='#f0f0f0')
    close_frame.pack(fill='x', pady=(10, 0))
    
    close_button = tk.Button(
        close_frame,
        text="Close",
        command=results_window.destroy,
        font=("Arial", 10),
        bg='#f44336',
        fg='white',
        padx=20
    )
    close_button.pack(side='right')
    
    # Show record count
    count_label = tk.Label(
        close_frame, 
        text=f"Showing {len(sorted_items)} records for Employee ID: {employee_id}",
        font=("Arial", 9),
        bg='#f0f0f0'
    )
    count_label.pack(side='left')

